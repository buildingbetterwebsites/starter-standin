# Copy to .env for local work, or run `vercel env pull .env` (it fills these from your Vercel project).
# Never commit .env: it holds secrets.
DATABASE_URL=
PAYLOAD_SECRET=
# The first admin, created on first start when no user exists. Set these in Vercel BEFORE the first deploy.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
# Added by Vercel when you connect a Blob store. Without it, uploads go to the local disk.
BLOB_READ_WRITE_TOKEN=
